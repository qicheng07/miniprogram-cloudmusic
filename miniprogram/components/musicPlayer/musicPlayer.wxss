.music-player {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  background: #1a1a1a;
  border-top: 1rpx solid #333;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
}

.player-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.player-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.player-name {
  font-size: 28rpx;
  color: #fff;
  margin-bottom: 6rpx;
}

.player-singer {
  font-size: 24rpx;
  color: #999;
}

.player-controls {
  flex: 1.5;
  margin: 0 16rpx;
}

.progress-bar {
  height: 6rpx;
  background: #333;
  border-radius: 3rpx;
}

.progress-fill {
  height: 100%;
  background: #e84c3d;
  border-radius: 3rpx;
  transition: width 0.3s ease;
}

.progress-time {
  display: flex;
  justify-content: space-between;
  margin-top: 8rpx;
}

.time-current,
.time-duration {
  font-size: 20rpx;
  color: #666;
}

.player-buttons {
  display: flex;
  align-items: center;
}

.btn-play {
  width: 64rpx;
  height: 64rpx;
  background: #e84c3d;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.play-icon {
  font-size: 24rpx;
  color: #fff;
  margin-left: 4rpx;
}

.btn-next {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.next-icon {
  font-size: 28rpx;
  color: #fff;
}