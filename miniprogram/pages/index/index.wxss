.container {
  padding-bottom: 120rpx;
}

.banner-swiper {
  height: 320rpx;
  margin-bottom: 30rpx;
}

.banner-image {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}

.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

.song-list {
  padding: 0 8rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.song-item:last-child {
  border-bottom: none;
}

.song-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.song-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.song-singer {
  font-size: 24rpx;
  color: #999;
}

.song-play-count {
  margin-left: 20rpx;
}

.play-count {
  font-size: 24rpx;
  color: #999;
}

.playlist-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.playlist-item {
  width: 31%;
  margin-bottom: 24rpx;
}

.playlist-cover {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.playlist-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.playlist-count {
  font-size: 22rpx;
  color: #999;
}