.container {
  padding-bottom: 120rpx;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 用户登录区域 */
.user-header {
  background: linear-gradient(135deg, #e84c3d 0%, #c0392b 100%);
  padding: 60rpx 30rpx 40rpx;
  display: flex;
  align-items: center;
}

.user-info {
  display: flex;
  align-items: center;
}

.user-avatar {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-welcome {
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
}

.welcome-text {
  font-size: 32rpx;
  color: #fff;
  font-weight: 600;
}

.welcome-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 8rpx;
}

.login-btn {
  display: flex;
  align-items: center;
  padding: 20rpx 40rpx;
  background: rgba(255, 255, 255, 0.2);
  border: 2rpx solid rgba(255, 255, 255, 0.5);
  border-radius: 40rpx;
}

.login-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.login-text {
  font-size: 28rpx;
  color: #fff;
}

/* 骨架屏 */
.skeleton {
  padding: 20rpx;
}

.skeleton-banner {
  width: 100%;
  height: 320rpx;
  background: #eee;
  border-radius: 16rpx;
  margin-bottom: 30rpx;
  animation: shimmer 1.5s infinite;
}

.skeleton-section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
}

.skeleton-title {
  width: 200rpx;
  height: 36rpx;
  background: #eee;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
  animation: shimmer 1.5s infinite;
}

.skeleton-line {
  width: 100%;
  height: 80rpx;
  background: #f5f5f5;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  animation: shimmer 1.5s infinite;
}

.skeleton-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.skeleton-card {
  width: 31%;
  height: 260rpx;
  background: #eee;
  border-radius: 12rpx;
  margin-bottom: 24rpx;
  animation: shimmer 1.5s infinite;
}

@keyframes shimmer {
  0% { opacity: 1; }
  50% { opacity: 0.6; }
  100% { opacity: 1; }
}

/* Banner */
.banner-swiper {
  height: 320rpx;
  margin: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.banner-image {
  width: 100%;
  height: 100%;
}

/* 视频入口 */
.video-entrance {
  display: flex;
  align-items: center;
  margin: 20rpx;
  padding: 24rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 16rpx;
}

.entrance-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
}

.entrance-content {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.entrance-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
  margin-bottom: 8rpx;
}

.entrance-desc {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

.entrance-arrow {
  font-size: 40rpx;
  color: rgba(255, 255, 255, 0.8);
}

/* Section */
.section {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 0 20rpx 20rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.section-more {
  font-size: 26rpx;
  color: #999;
}

/* Error Tip */
.error-tip {
  background: #fff3cd;
  border: 1rpx solid #ffeeba;
  border-radius: 12rpx;
  padding: 20rpx;
  margin: 0 20rpx 20rpx;
  display: flex;
  align-items: center;
}

.error-icon {
  font-size: 32rpx;
  margin-right: 12rpx;
}

.error-text {
  font-size: 26rpx;
  color: #856404;
}

/* Song List */
.song-list {
  padding: 0 8rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.song-item:last-child {
  border-bottom: none;
}

.song-item:active {
  background: #f9f9f9;
}

.song-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.song-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.song-singer {
  font-size: 24rpx;
  color: #999;
}

.song-play-count {
  margin-left: 20rpx;
}

.play-count {
  font-size: 24rpx;
  color: #999;
}

/* Playlist Grid */
.playlist-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.playlist-item {
  width: 31%;
  margin-bottom: 24rpx;
}

.playlist-cover {
  width: 100%;
  height: 200rpx;
  border-radius: 12rpx;
  margin-bottom: 12rpx;
}

.playlist-name {
  font-size: 26rpx;
  color: #333;
  display: block;
  margin-bottom: 6rpx;
}

.playlist-count {
  font-size: 22rpx;
  color: #999;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}