.player-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a1a1a 0%, #2d2d2d 100%);
  padding: 40rpx;
  padding-bottom: 80rpx;
  display: flex;
  flex-direction: column;
}

.cover-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.cover-wrapper {
  width: 500rpx;
  height: 500rpx;
  border-radius: 50%;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 10rpx 40rpx rgba(0, 0, 0, 0.5);
}

.cover-image {
  width: 100%;
  height: 100%;
}

.song-info {
  text-align: center;
}

.song-name {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

.song-singer {
  font-size: 28rpx;
  color: #999;
}

.lyric-section {
  flex: 1;
  margin-bottom: 30rpx;
}

.lyric-scroll {
  height: 400rpx;
}

.lyric-item {
  text-align: center;
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #666;
  transition: all 0.3s;
}

.lyric-item.active {
  color: #e84c3d;
  font-size: 32rpx;
  font-weight: 600;
}

.progress-section {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
}

.time-text {
  font-size: 24rpx;
  color: #999;
  width: 100rpx;
}

.progress-slider {
  flex: 1;
  margin: 0 20rpx;
}

.control-section {
  display: flex;
  justify-content: center;
  align-items: center;
}

.control-btn {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
}

.mode-btn {
  margin-right: 10rpx;
}

.play-btn {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #e84c3d 0%, #c0392b 100%);
  border-radius: 50%;
  margin: 0 30rpx;
  font-size: 48rpx;
  color: #fff;
  box-shadow: 0 8rpx 20rpx rgba(232, 76, 61, 0.5);
}

.like-btn {
  margin-left: 10rpx;
}

.download-btn {
  margin-left: 10rpx;
}

.download-progress {
  position: fixed;
  bottom: 200rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 600rpx;
  padding: 24rpx;
  background: rgba(0, 0, 0, 0.8);
  border-radius: 16rpx;
  z-index: 1000;
}

.progress-bar {
  width: 100%;
  height: 12rpx;
  background: #333;
  border-radius: 6rpx;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #e84c3d 0%, #c0392b 100%);
  border-radius: 6rpx;
  transition: width 0.3s ease;
}

.progress-text {
  display: block;
  text-align: center;
  color: #fff;
  font-size: 24rpx;
}
