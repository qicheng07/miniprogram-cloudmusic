.search-container {
  padding: 20rpx;
  min-height: 100vh;
  background: #f5f5f5;
}

.search-bar {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 40rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.08);
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  height: 60rpx;
}

.search-btn {
  margin-left: 16rpx;
}

.search-icon {
  font-size: 32rpx;
}

.search-content {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.clear-history {
  font-size: 26rpx;
  color: #999;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
}

.hot-tag {
  background: linear-gradient(135deg, #fff5f5 0%, #ffe5e5 100%);
  color: #e84c3d;
  padding: 16rpx 28rpx;
  border-radius: 30rpx;
  margin-right: 20rpx;
  margin-bottom: 16rpx;
  font-size: 26rpx;
}

.hot-tag:active {
  opacity: 0.8;
}

.history-list {
  padding-top: 10rpx;
}

.history-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.history-item:last-child {
  border-bottom: none;
}

.history-text {
  font-size: 28rpx;
  color: #333;
}

.delete-history {
  font-size: 28rpx;
  color: #ccc;
  padding: 0 10rpx;
}

/* Search Results */
.search-results {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
}

.loading {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.loading-spinner {
  width: 48rpx;
  height: 48rpx;
  border: 4rpx solid #eee;
  border-top-color: #e84c3d;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 20rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #999;
}

.result-header {
  margin-bottom: 20rpx;
  font-size: 26rpx;
  color: #999;
}

.result-list {
  padding: 0 8rpx;
}

.result-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.result-item:last-child {
  border-bottom: none;
}

.result-item:active {
  background: #f9f9f9;
}

.result-cover {
  width: 96rpx;
  height: 96rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.result-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.result-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.result-singer {
  font-size: 24rpx;
  color: #999;
}

.result-duration {
  font-size: 24rpx;
  color: #999;
  margin-right: 16rpx;
}

.result-play {
  width: 60rpx;
  height: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #e84c3d;
  border-radius: 50%;
  color: #fff;
  font-size: 24rpx;
}

/* No Results */
.no-results {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}

.no-results-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.no-results-text {
  font-size: 30rpx;
  color: #666;
  margin-bottom: 8rpx;
}

.no-results-tip {
  font-size: 26rpx;
  color: #999;
}
