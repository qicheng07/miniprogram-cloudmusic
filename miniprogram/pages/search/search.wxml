<view class="search-container">
  <view class="search-bar">
    <input
      class="search-input"
      placeholder="搜索歌曲、歌手"
      value="{{keyword}}"
      bindinput="onSearchInput"
      confirm-type="search"
      bindconfirm="onSearch"
      focus="{{false}}"
    />
    <view class="search-btn" bindtap="onSearch">
      <text class="search-icon"></text>
    </view>
  </view>

  <!-- 搜索历史与热搜 -->
  <view wx:if="{{showHistory}}" class="search-content">
    <view class="hot-search">
      <view class="section-header">
        <text class="section-title">热门搜索</text>
      </view>
      <view class="hot-tags">
        <view
          wx:for="{{hotKeywords}}"
          wx:key="*this"
          class="hot-tag"
          bindtap="searchHotKeyword"
          data-keyword="{{item}}"
        >
          {{item}}
        </view>
      </view>
    </view>

    <view wx:if="{{historyKeywords.length > 0}}" class="history-search">
      <view class="section-header">
        <text class="section-title">搜索历史</text>
        <text class="clear-history" bindtap="clearHistory">清空</text>
      </view>
      <view class="history-list">
        <view
          wx:for="{{historyKeywords}}"
          wx:key="*this"
          class="history-item"
        >
          <text class="history-text" bindtap="searchHotKeyword" data-keyword="{{item}}">{{item}}</text>
          <text class="delete-history" bindtap="deleteHistoryItem" data-keyword="{{item}}">✕</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 搜索结果 -->
  <view wx:elif="{{searched}}" class="search-results">
    <view wx:if="{{loading}}" class="loading">
      <view class="loading-spinner"></view>
      <text class="loading-text">搜索中...</text>
    </view>
    <view wx:elif="{{searchResults.length > 0}}" class="result-list">
      <view class="result-header">
        <text>找到 {{searchResults.length}} 首歌曲</text>
      </view>
      <view
        wx:for="{{searchResults}}"
        wx:key="_id"
        class="result-item"
        bindtap="playSong"
        data-song="{{item}}"
      >
        <image src="{{item.coverUrl}}" class="result-cover" mode="aspectFill" />
        <view class="result-info">
          <text class="result-name">{{item.name}}</text>
          <text class="result-singer">{{item.singer}} · {{item.album}}</text>
        </view>
        <view class="result-duration">
          <text>{{formatDuration(item.duration)}}</text>
        </view>
        <view class="result-play">
          <text>▶</text>
        </view>
      </view>
    </view>
    <view wx:else class="no-results">
      <text class="no-results-icon"></text>
      <text class="no-results-text">未找到相关歌曲</text>
      <text class="no-results-tip">换个关键词试试</text>
    </view>
  </view>
</view>
