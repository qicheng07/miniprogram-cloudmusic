.profile-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding-bottom: 120rpx;
}

.user-header {
  background: linear-gradient(135deg, #e84c3d 0%, #c0392b 100%);
  padding: 60rpx 30rpx 40rpx;
  display: flex;
  align-items: center;
}

.avatar-btn {
  padding: 0;
  margin: 0;
  background: transparent;
  border: none;
  line-height: 1;
}

.avatar-btn::after {
  display: none;
}

.avatar {
  width: 140rpx;
  height: 140rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.5);
}

.user-info {
  margin-left: 30rpx;
}

.user-name {
  font-size: 36rpx;
  color: #fff;
  font-weight: 600;
  display: block;
  margin-bottom: 10rpx;
}

.user-desc {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.8);
}

.stats-row {
  display: flex;
  justify-content: center;
  align-items: center;
  background: #fff;
  padding: 30rpx 0;
}

.stat-item {
  flex: 1;
  text-align: center;
}

.stat-num {
  font-size: 36rpx;
  font-weight: 600;
  color: #333;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #999;
}

.stat-divider {
  width: 1rpx;
  height: 40rpx;
  background: #eee;
}

.section {
  background: #fff;
  margin: 20rpx;
  border-radius: 16rpx;
  padding: 24rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #333;
}

.create-btn {
  font-size: 26rpx;
  color: #e84c3d;
  padding: 8rpx 20rpx;
  border: 2rpx solid #e84c3d;
  border-radius: 20rpx;
}

.create-btn:active {
  opacity: 0.8;
}

.playlist-list {
  padding: 0 8rpx;
}

.playlist-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.playlist-item:last-child {
  border-bottom: none;
}

.playlist-cover {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.playlist-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.playlist-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.playlist-desc {
  font-size: 24rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.playlist-count {
  font-size: 22rpx;
  color: #999;
}

.song-list {
  padding: 0 8rpx;
}

.song-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.song-item:last-child {
  border-bottom: none;
}

.song-item:active {
  background: #f9f9f9;
}

.song-cover {
  width: 80rpx;
  height: 80rpx;
  border-radius: 8rpx;
  margin-right: 20rpx;
}

.song-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}

.song-name {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 8rpx;
}

.song-singer {
  font-size: 24rpx;
  color: #999;
}

.song-arrow {
  color: #ccc;
  font-size: 36rpx;
}

/* Empty State */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
  margin-bottom: 8rpx;
}

.empty-tip {
  font-size: 24rpx;
  color: #ccc;
}

/* Modal */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}

.modal-content {
  width: 560rpx;
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
  text-align: center;
  display: block;
  margin-bottom: 30rpx;
}

.modal-input {
  width: 100%;
  font-size: 30rpx;
  color: #333;
  border: 2rpx solid #eee;
  border-radius: 12rpx;
  padding: 20rpx;
  box-sizing: border-box;
  margin-bottom: 30rpx;
}

.modal-btns {
  display: flex;
  justify-content: space-between;
}

.modal-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.modal-btn.cancel {
  color: #666;
  background: #f5f5f5;
  margin-right: 20rpx;
}

.modal-btn.confirm {
  color: #fff;
  background: #e84c3d;
}

.modal-btn:active {
  opacity: 0.8;
}

.settings-icon {
  margin-left: auto;
  padding: 16rpx;
}

.settings-icon-text {
  font-size: 40rpx;
}

.menu-list {
  padding: 0 8rpx;
}

.menu-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
}

.menu-text {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.menu-arrow {
  font-size: 32rpx;
  color: #ccc;
}
