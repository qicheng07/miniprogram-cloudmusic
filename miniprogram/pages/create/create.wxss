.create-container {
  min-height: 100vh;
  background: #f5f5f5;
  padding: 30rpx;
}

.form-item {
  background: #fff;
  padding: 24rpx;
  margin-bottom: 20rpx;
  border-radius: 16rpx;
}

.form-label {
  font-size: 28rpx;
  color: #333;
  margin-bottom: 16rpx;
  display: block;
}

.form-input {
  font-size: 30rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
}

.form-textarea {
  font-size: 30rpx;
  color: #333;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #eee;
  min-height: 120rpx;
}

.form-switch {
  float: right;
}

.submit-btn {
  background: linear-gradient(135deg, #e84c3d 0%, #c0392b 100%);
  color: #fff;
  text-align: center;
  padding: 28rpx;
  margin-top: 40rpx;
  border-radius: 40rpx;
  font-size: 32rpx;
  font-weight: 600;
}