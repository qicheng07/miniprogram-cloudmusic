<view class="container">
  <view class="header">
    <view class="back-btn" bindtap="goBack">
      <text class="back-icon">←</text>
    </view>
    <text class="header-title">设置</text>
    <view class="placeholder"></view>
  </view>

  <view class="section">
    <view class="section-title">账号设置</view>
    <view class="setting-list">
      <view class="setting-item" bindtap="onLogout">
        <view class="item-icon">👤</view>
        <view class="item-content">
          <text class="item-title">退出登录</text>
          <text class="item-desc">退出当前账号</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">播放设置</view>
    <view class="setting-list">
      <view class="setting-item">
        <view class="item-icon">▶</view>
        <view class="item-content">
          <text class="item-title">自动播放</text>
          <text class="item-desc">进入页面自动播放音乐</text>
        </view>
        <switch class="item-switch" checked="{{settings.autoPlay}}" bindchange="onAutoPlayChange" />
      </view>
      <view class="setting-item">
        <view class="item-icon">🎵</view>
        <view class="item-content">
          <text class="item-title">高清音质</text>
          <text class="item-desc">使用高质量音频播放</text>
        </view>
        <switch class="item-switch" checked="{{settings.highQuality}}" bindchange="onHighQualityChange" />
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">通知设置</view>
    <view class="setting-list">
      <view class="setting-item">
        <view class="item-icon">🔔</view>
        <view class="item-content">
          <text class="item-title">推送通知</text>
          <text class="item-desc">接收新歌推荐和活动通知</text>
        </view>
        <switch class="item-switch" checked="{{settings.notification}}" bindchange="onNotificationChange" />
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">显示设置</view>
    <view class="setting-list">
      <view class="setting-item">
        <view class="item-icon">🌙</view>
        <view class="item-content">
          <text class="item-title">深色模式</text>
          <text class="item-desc">切换深色主题</text>
        </view>
        <switch class="item-switch" checked="{{settings.darkMode}}" bindchange="onDarkModeChange" />
      </view>
    </view>
  </view>

  <view class="section">
    <view class="section-title">其他</view>
    <view class="setting-list">
      <view class="setting-item" bindtap="onClearCache">
        <view class="item-icon">🗑️</view>
        <view class="item-content">
          <text class="item-title">清理缓存</text>
          <text class="item-desc">清除本地存储数据</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
      <view class="setting-item" bindtap="onFeedback">
        <view class="item-icon">💬</view>
        <view class="item-content">
          <text class="item-title">意见反馈</text>
          <text class="item-desc">帮助我们改进</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
      <view class="setting-item" bindtap="onAbout">
        <view class="item-icon">ℹ️</view>
        <view class="item-content">
          <text class="item-title">关于我们</text>
          <text class="item-desc">版本 v{{version}}</text>
        </view>
        <text class="item-arrow">›</text>
      </view>
    </view>
  </view>
</view>